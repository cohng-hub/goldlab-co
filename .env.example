# ==============================================================
# GoldLab&co Production Configuration Template (.env.example)
# IMPORTANT: Copy this file to '.env' and fill in your secure values.
# NEVER commit the actual '.env' file to public version control!
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
APP_ORIGIN=https://goldlabnco.com

# Core Security & Session Secrets (Generate strong random 64-char hex strings)
# e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=YOUR_RANDOM_SECURE_SESSION_SECRET_HEX_HERE
CSRF_SECRET=YOUR_RANDOM_SECURE_CSRF_SECRET_HEX_HERE
CERT_TOKEN_PEPPER=YOUR_SECURE_PEPPER_FOR_CERTIFICATE_VERIFY_TOKENS

# Master Administrator Setup
# NOTE: The previous hardcoded master password must be permanently rotated/deprecated!
ADMIN_EMAIL=admin@goldlabnco.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TO_A_SECURE_16_CHAR_PASSWORD_ON_FIRST_BOOT
ADMIN_2FA_ENABLED=false
ADMIN_2FA_SECRET=OPTIONAL_TOTP_BASE32_SECRET

# Korea Gold Exchange API Proxy / Sync Settings
KGE_API_ENDPOINT=https://koreagoldx.co.kr/api/main
GOLD_RATE_UPDATE_INTERVAL_MIN=15

# Customer Support & Communication Channels
KAKAO_TALK_CHANNEL_URL=https://pf.kakao.com/_goldlab_sample
CUSTOMER_CENTER_TEL=02-765-8888
CS_EMAIL=cs@goldlabnco.com

# External Integration Adapters (Leave blank or 'mock' until contracts are finalized)
# Payment Gateway (e.g., Toss Payments / KG Inicis / PortOne)
PG_PROVIDER=mock
PG_CLIENT_KEY=
PG_SECRET_KEY=

# Notification Service (AlimTalk / SMS - e.g., Aligo, Solapi, CoolSMS)
NOTIFY_PROVIDER=mock
NOTIFY_API_KEY=
NOTIFY_SENDER_PHONE=

# Storage Provider (Local secure filesystem or AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_BASE_PATH=./uploads
